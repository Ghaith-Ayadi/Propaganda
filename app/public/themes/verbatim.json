{
  "api": 1,
  "id": "verbatim",
  "name": "Verbatim",
  "version": "1.0.0",
  "summary": "Verbatim's own: Roslindale headlines, Charter prose, the wordmark.",
  "audience": "Verbatim only (Roslindale is licensed to this site, so the theme is custom, not public).",
  "fonts": {
    "display": "Roslindale Display",
    "text": "Charter",
    "ui": "Geist",
    "mono": "Geist Mono",
    "custom": {
      "Roslindale Display": {
        "src": "/fonts/RoslindaleVariableDisplay-VF.ttf",
        "format": "truetype-variations",
        "weight": "100 1000",
        "stack": "\"Roslindale Display\", \"Geist\", -apple-system, system-ui, serif",
        "avgChar": 0.46
      },
      "Charter": {
        "stack": "\"Charter\", \"Source Serif 4\", \"Iowan Old Style\", \"Apple Garamond\", Georgia, Cambria, \"Times New Roman\", serif",
        "avgChar": 0.47
      },
      "Geist": {
        "stack": "\"Geist\", -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
        "avgChar": 0.46
      },
      "Geist Mono": {
        "stack": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
        "avgChar": 0.6
      }
    }
  },
  "brand": { "logo": "/brand/verbatim.svg", "wordmark": true },
  "color": { "paper": "#FFFFFF", "ink": "#000000", "accent": "#34783F", "highlight": "#E3F0E4" },
  "type": {
    "text": { "size": [16, 21], "leading": 1.58, "weight": 400, "strong": 650 },
    "scale": [1.2, 1.3],
    "figures": "oldstyle",
    "display": { "weight": 500, "leading": 1.02, "tracking": -0.03 },
    "title": { "weight": 500, "font": "display", "tracking": -0.015 },
    "dek": { "font": "ui", "style": "normal" },
    "brand": { "font": "display", "weight": 500, "tracking": -0.02 },
    "label": { "font": "ui", "case": "upper", "tracking": 0.12, "weight": 500, "color": "muted", "step": -1 },
    "meta": { "font": "ui", "step": -1 },
    "nav": { "font": "ui", "step": -1, "weight": 500 },
    "roles": { "brand": 2, "manifesto": 4, "postTitle": 6, "collTitle": 5, "cardTitle": 1, "indexTitle": 0, "leadTitle": 4, "dek": 1, "section": -1 }
  },
  "space": { "unit": 4, "density": 1.05 },
  "shape": { "radius": 0, "imageRadius": 0, "avatar": "circle", "rule": "solid", "headerRule": "thin", "footerRule": "thin", "leader": "none", "card": "plain" },
  "layout": { "container": 1120, "measure": 64, "margin": 0, "wide": 140, "header": "inline", "footer": "minimal", "gridMin": 260, "imageRatio": "3 / 2" },
  "prose": { "paragraph": "space", "ornament": "* * *", "quote": "strong", "quoteItalic": false, "link": "underline", "caption": "start", "code": "panel" },
  "images": { "filter": "none" },
  "format": { "date": "medium", "readTime": "short", "number": "No. {n}" },
  "presets": {
    "frame": { "header": { "tagline": false, "sticky": false }, "footer": { "poweredBy": true } },
    "home": {
      "intro": { "variant": "manifesto", "stats": true },
      "feed": { "mode": "tabs", "layout": "rows", "card": "summary", "lead": false, "group": "none", "number": false, "dek": true, "readTime": true, "collection": "auto", "limit": "24" }
    },
    "collection": {
      "header": { "variant": "plain", "description": true, "count": true, "siblings": true },
      "posts": { "layout": "rows", "card": "summary", "lead": false, "group": "none", "number": false, "dek": true, "readTime": true, "collection": "auto", "limit": "24" }
    },
    "post": {
      "header": { "align": "start", "width": "content", "dek": true, "byline": true, "readTime": true, "number": false },
      "body": { "dropCap": false, "images": "column" },
      "after": { "authorCard": false, "details": true, "nav": "cards", "more": "none" }
    },
    "author": {
      "header": { "variant": "split", "avatar": true, "links": true },
      "posts": { "layout": "rows", "card": "index", "lead": false, "group": "year", "number": false, "dek": false, "readTime": false, "collection": "show", "limit": "24" }
    }
  }
}
