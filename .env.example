# --- app/ (Vite) -------------------------------------------------------------
# PocketBase on Bedrock (Ghaith-Ayadi/Bedrock). The app and its API share one
# origin, so this is simply the app's own host. Works for local dev too: the
# data is production, sign in with Google.
VITE_PB_URL=https://verbatim.ayadighaith.com

# Analytics: Cloudflare Worker that ingests page-view beacons (/collect) and
# serves dashboard aggregates (/query). All VITE_* values ship in the client
# bundle, so the query key is a soft gate, not real auth. Leave unset to run the
# dashboard in simulated mode only.
VITE_ANALYTICS_URL=https://your-worker.workers.dev
VITE_ANALYTICS_QUERY_KEY=
VITE_ANALYTICS_TENANT=verbatim

# --- api/ (Vercel functions, server-only) ------------------------------------
# Vercel Blob store for images (api/upload.ts). Shared with Shelf.
BLOB_READ_WRITE_TOKEN=

# Gemini API key, server-only, never exposed to the browser.
GEMINI_API_KEY=

# --- legacy ------------------------------------------------------------------
# scripts/src/* are Supabase-era one-off admin tools and still read
# SUPABASE_* variables. The Supabase project is kept until 2026-10-16 as a
# rollback and is not written to. Nothing in app/ or api/ uses these any more.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=
# RESEND_API_KEY=
