VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (MCP server, migration scripts). Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection (used by scripts/migrate.ts).
SUPABASE_DB_PASSWORD=
# Optional: full Postgres connection string override. If unset, scripts build a direct (IPv6) URL.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Resend API key — used as SMTP password in Supabase Auth + reserved for server-side use.
RESEND_API_KEY=

# Gemini API key — server-only, never expose to browser.
GEMINI_API_KEY=

# Supabase keep-alive cron (/api/keepalive, scheduled in vercel.json).
# The function reads SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY and falls back to
# the VITE_* pair above, so on Vercel it works with no extra config. Vercel sets
# CRON_SECRET itself when you add it in project settings; the function only
# enforces the Bearer check when the var exists.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# CRON_SECRET=

# Supabase Management API personal access token, from
# https://supabase.com/dashboard/account/tokens. Only needed by
# scripts/src/configure-auth-smtp.ts, which sets Auth SMTP and the redirect
# allow-list (there is no SQL for those, and the dashboard is otherwise the
# only place to change them).
# SUPABASE_ACCESS_TOKEN=

# Analytics — Cloudflare Worker that ingests page-view beacons (/collect) and
# serves dashboard aggregates (/query). All VITE_* values ship in the client
# bundle, so the query key is a soft gate, not real auth. Leave unset to run the
# dashboard in simulated mode only.
VITE_ANALYTICS_URL=https://your-worker.workers.dev
VITE_ANALYTICS_QUERY_KEY=
VITE_ANALYTICS_TENANT=verbatim
