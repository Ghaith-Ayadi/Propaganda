VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (MCP server, migration scripts). Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection (used by scripts/migrate.ts).
SUPABASE_DB_PASSWORD=
# Optional: full Postgres connection string override. If unset, scripts build a direct (IPv6) URL.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Resend API key — used as SMTP password in Supabase Auth + reserved for server-side use.
RESEND_API_KEY=

# Gemini API key — server-only, never expose to browser.
GEMINI_API_KEY=

# Analytics — Cloudflare Worker that ingests page-view beacons (/collect) and
# serves dashboard aggregates (/query). All VITE_* values ship in the client
# bundle, so the query key is a soft gate, not real auth. Leave unset to run the
# dashboard in simulated mode only.
VITE_ANALYTICS_URL=https://your-worker.workers.dev
VITE_ANALYTICS_QUERY_KEY=
VITE_ANALYTICS_TENANT=verbatim
