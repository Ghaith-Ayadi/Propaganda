# --- app/ (Vite) -------------------------------------------------------------
# Self-hosted Supabase on Bedrock (Ghaith-Ayadi/Bedrock; schema in supabase/).
# The app host serves the API too (/auth/v1, /rest/v1, /realtime/v1). Works for
# local dev: the data is production, sign in with Google. Or run the stack on
# the laptop (supabase/README.md): http://localhost:54321 and its anon key.
# The anon key is public: it only identifies the project, sessions do the rest.
VITE_SUPABASE_URL=https://app.propaganda.pub
VITE_SUPABASE_ANON_KEY=

# Where blogs live: https://<site slug>.<VITE_PLATFORM_DOMAIN>, with the editor
# on app.<domain> (default propaganda.pub). In dev, set it to localhost: blogs
# open at http://<slug>.localhost:5173 and the editor at http://localhost:5173.
# VITE_PLATFORM_DOMAIN=localhost

# Analytics: Cloudflare Worker that ingests page-view beacons (/collect) and
# serves dashboard aggregates (/query). Beacons (/collect) are public and
# still sent straight from the browser, tagged with VITE_ANALYTICS_TENANT.
# Dashboard reads (/query) go through api/analytics.ts instead (server-side,
# see below) — VITE_ANALYTICS_URL here only switches the dashboard out of
# simulated mode; the client never holds the Worker's query key. Leave
# VITE_ANALYTICS_URL unset to run the dashboard in simulated mode only.
VITE_ANALYTICS_URL=https://your-worker.workers.dev
VITE_ANALYTICS_TENANT=verbatim

# Errors and product analytics: PostHog Cloud (EU), editor only
# (app/src/lib/telemetry.ts). The project API key is public by design. The
# Vercel functions read the same variable for server errors (api/_telemetry.ts).
# Unset: telemetry is off (local dev, previews).
# VITE_POSTHOG_KEY=phc_...

# Chat (app/src/lib/chat/adapter.ts): "http" talks to the real Chat agent
# (/api/chat); unset, the page shows example replies kept in this browser.
# Needs the chat tables (draft migration) and the server keys below.
# VITE_CHAT_BACKEND=http

# --- api/ (Vercel functions, server-only) ------------------------------------
# Vercel Blob store for images (api/upload.ts). Shared with Shelf.
BLOB_READ_WRITE_TOKEN=

# Gemini API key, server-only, never exposed to the browser.
GEMINI_API_KEY=

# The backend, for server-side auth/membership checks (api/_auth.ts,
# api/analytics.ts). Same values as above; set them in Vercel too
# (VITE_* are inlined at build time, these are read at request time).
SUPABASE_URL=https://app.propaganda.pub
SUPABASE_ANON_KEY=

# Chat and the cost log write with the service role (api/_ai/gateway.ts,
# api/_chat/store.ts). Server-only, never VITE_.
# SUPABASE_SERVICE_ROLE_KEY=
# The model every agent and Chat uses, as the AI Gateway names it (default
# deepseek/deepseek-v4-pro), and what it becomes for a tenant that saved its own
# Anthropic key (default anthropic/claude-sonnet-5.5). CHAT_MODEL overrides Chat
# alone. Non-Google ids go through the AI Gateway, or the tenant's own key.
# DEFAULT_MODEL=
# BYOK_MODEL=
# CHAT_MODEL=
# AI_GATEWAY_API_KEY=
# The worker's dispatch route, so Chat can hand work to the other agents
# (api/_chat/dispatch.ts). Unset: hand-offs say the agent isn't running yet.
# WORKER_DISPATCH_URL=https://app.propaganda.pub/worker/v1
# WORKER_DISPATCH_SECRET=

# The analytics Worker's base URL and its /query gate key, both server-only.
# api/analytics.ts looks up the requesting site's tenant in the backend and
# forwards the request with this key attached — the browser never sees it.
ANALYTICS_URL=https://your-worker.workers.dev
ANALYTICS_QUERY_KEY=

# --- legacy ------------------------------------------------------------------
# scripts/src/* are Supabase-era one-off admin tools and still read
# SUPABASE_* variables. The Supabase project is kept until 2026-10-16 as a
# rollback and is not written to. Nothing in app/ or api/ uses these any more.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=
# RESEND_API_KEY=
